# Database Configuration for Sequelize
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=oron_db
NODE_ENV=development

# Socket.IO (optional): only works on a long-running Node server, NOT Vercel serverless.
# Vercel deployments: frontend uses HTTP polling (VITE_REALTIME_MODE=polling or auto in production).
# CORS_ORIGIN=http://localhost:5173

# AES-256-GCM resident data encryption (any strong secret; hashed with SHA-256 before use)
ENCRYPTION_KEY=

# OneSignal (push) — create an app at https://onesignal.com and use Web + REST API key
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# When true, disables browser push (use in-app notifications only).
DISABLE_BROWSER_NOTIFICATIONS=true

# Public web app URL used in set-password invitation emails (e.g. https://app.example.com).
# Falls back to VITE_API_URL when unset (same variable name used in some deployments).
FRONTEND_URL=
# VITE_API_URL=http://localhost:5173

# HTTPS URL shown in transactional email headers (set-password + password-reset OTP). Use PNG/SVG on a CDN.
EMAIL_LOGO_URL=
