{
  "info": {
    "_postman_id": "oron-seniorcare-api",
    "name": "Oron SeniorCare API",
    "description": "Postman collection for the Oron SeniorCare NestJS backend.\n\n**Setup**\n1. Import this collection (and optionally `Oron-SeniorCare-Local.postman_environment.json`).\n2. Set `baseUrl` (default `http://localhost:3000`).\n3. Run **Auth → Login** or **Owner Login** — the test script saves `accessToken` and user scope IDs.\n4. Protected requests use Bearer `{{accessToken}}` automatically.\n\n**Swagger:** `{{baseUrl}}/api`\n\n**Roles:** `OWNER`, `FACILITY_ADMIN`, `BRANCH_ADMIN`, `STAFF`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level Bearer auth; Auth folder requests override with noauth."
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "facilityId", "value": "" },
    { "key": "branchId", "value": "" },
    { "key": "residentId", "value": "" },
    { "key": "staffId", "value": "" },
    { "key": "alertId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "carePlanId", "value": "" },
    { "key": "inviteCode", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Public endpoints — no Bearer token required.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const saveAuth = () => {",
                  "  const json = pm.response.json();",
                  "  if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);",
                  "  if (json.user?.id) pm.collectionVariables.set('userId', json.user.id);",
                  "  if (json.user?.facilityId) pm.collectionVariables.set('facilityId', json.user.facilityId);",
                  "  if (json.user?.branchId) pm.collectionVariables.set('branchId', json.user.branchId);",
                  "};",
                  "if (pm.response.code === 200 || pm.response.code === 201) saveAuth();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Login for Facility Admin, Branch Admin, and Staff."
          }
        },
        {
          "name": "Owner Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const saveAuth = () => {",
                  "  const json = pm.response.json();",
                  "  if (json.access_token) pm.collectionVariables.set('accessToken', json.access_token);",
                  "  if (json.user?.id) pm.collectionVariables.set('userId', json.user.id);",
                  "};",
                  "if (pm.response.code === 200 || pm.response.code === 201) saveAuth();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/owner/login",
            "description": "Login for Owner role only."
          }
        },
        {
          "name": "Verify Invite Code",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"{{inviteCode}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/verify-invite"
          }
        },
        {
          "name": "Set Password (Invite)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inviteCode\": \"{{inviteCode}}\",\n  \"password\": \"NewPassword1!\",\n  \"confirmPassword\": \"NewPassword1!\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/set"
          }
        },
        {
          "name": "Forgot Password — Request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/forgot/request-otp"
          }
        },
        {
          "name": "Forgot Password — Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/forgot/verify-otp"
          }
        },
        {
          "name": "Forgot Password — Reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"NewPassword1!\",\n  \"confirmPassword\": \"NewPassword1!\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/forgot/reset"
          }
        }
      ]
    },
    {
      "name": "Health",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Root Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
